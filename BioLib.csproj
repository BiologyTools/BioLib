<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>BioLib</Title>
    <Description>A GUI-less version of Bio .NET library for editing &amp; annotating various microscopy image formats. Supports all bioformats supported images. Integrates with ImageJ, running ImageJ filters &amp; macro functions. Supports Windows, Linux and Mac.</Description>
    <PackageIcon>banner.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/BiologyTools/BioLib</RepositoryUrl>
    <AssemblyVersion>4.3.2</AssemblyVersion>
    <FileVersion>4.3.2</FileVersion>
    <PackageVersion>4.3.2</PackageVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://biologytools.github.io/</PackageProjectUrl>
    <PackageTags>Biology; ImageJ; Bio-Formats; OMERO; Image-Stacks; Microscopy; Whole-Slide-Image; QuPath; Napari; </PackageTags>
    <PackageReleaseNotes>BioLib 4.3.2 updates core imaging and scripting dependencies:
- Updates BioFormats.NET6 to 9.0.0-rc4 and unifies Bio-Formats, Fiji, and OMERO on IKVM11 8.15.3 with the macOS native JVM image.
- Updates ZarrNET to 0.8.2 for the latest OME-Zarr compatibility and fixes.
- Updates SkiaSharp to 4.156.0 and CS-Script to 4.14.14.
</PackageReleaseNotes>
    <Authors>Erik Repo</Authors>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="LICENSE" />
    <Content Include="tile_copy.cu">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tile_copy.ptx">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<Pack>True</Pack>
		<PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>
	<ItemGroup>
	<PackageReference Include="AForgeBio" Version="2.5.1" />
	<PackageReference Include="BioFormats.NET6" Version="9.0.0-rc4">
		<Aliases>BioFormats</Aliases>
	</PackageReference>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="CS-Script" Version="4.14.14" />
    <PackageReference Include="Fiji.NET" Version="0.1.2" Aliases="FijiNet" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NuGet.Build.Tasks.Pack" Version="6.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OMERO.NET" Version="1.0.7" />
    <PackageReference Include="OpenSlideGTK" Version="2.8.1" />
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
    <PackageReference Include="ZarrNET" Version="0.8.2" />
  </ItemGroup>
  <ItemGroup>
    <None Update="banner.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="macro-commands.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
    </None>
    <None Update="macro-functions.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>




